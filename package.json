{
  "name": "video-editor",
  "version": "0.0.1",
  "private": true,
  "description": "Local desktop multitrack video editor (Clipchamp-inspired UI).",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-packager . \"Video Editor\" --platform=darwin --arch=arm64 --out=dist --overwrite",
    "postpackage:mac": "node scripts/zip-mac.cjs && node scripts/drive-drop.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^33.0.0"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "ffmpeg-static@5.3.0": true
  }
}
